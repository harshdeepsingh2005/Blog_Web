# .env.example
# Copy this file to .env and update the values for your deployment

SECRET_KEY="your-super-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# PostgreSQL connection string provided by your hosting provider (e.g., Render, Supabase)
DATABASE_URL="postgresql://user:password@hostname.com/dbname"

# Deployment URLs
BASE_URL="https://your-render-app.onrender.com"
CORS_ORIGINS='["https://your-vercel-frontend.vercel.app", "http://localhost:5173"]'
